<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- The installed model is large and locally provisioned; never back it up. -->
        <exclude domain="file" path="ai_models/" />
        <!-- TRACE contains operational metadata and is local audit material only. -->
        <exclude domain="file" path="ai_trace.jsonl" />
        <exclude domain="file" path="ai_trace.jsonl.tmp" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="ai_models/" />
        <exclude domain="file" path="ai_trace.jsonl" />
        <exclude domain="file" path="ai_trace.jsonl.tmp" />
    </device-transfer>
</data-extraction-rules>
