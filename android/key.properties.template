# Local Android Release signing configuration example.
# IMPORTANT: an existing installation can only be upgraded in place with the same signing certificate.
# Do NOT generate a new keystore for an already-installed app. Restore and use the original signing key.
# Place the existing keystore under android/ or adjust storeFile to its actual location.
# storeFile is resolved relative to android/app/, so ../nihaisha.jks refers to android/nihaisha.jks.

storePassword=填入原密钥库密码
keyPassword=填入原密钥密码
keyAlias=填入原证书别名
storeFile=../nihaisha.jks
storeType=PKCS12
